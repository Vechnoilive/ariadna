[
  {
    "id": "coverage_search",
    "version": "1.0",
    "title": "Распределённый поиск и покрытие",
    "purpose": "Распределённый поиск и покрытие",
    "participants": {
      "selection": "public capability and feasible task pairs"
    },
    "required_capabilities": [
      "move",
      "observe"
    ],
    "game_model": {
      "class": "potential",
      "players": [
        "scout"
      ],
      "N": "eligible public agents",
      "Ai": [
        "move",
        "observe",
        "hold"
      ],
      "Ii": "public observation and previously received public observations only",
      "Ui": "10*new_cell*confidence - distance*0.05 - energy_cost*2",
      "utility_weights": {
        "new_cell": 10.0,
        "distance": 0.05,
        "energy": 2.0
      },
      "K": [
        "one_command_per_agent",
        "reserve",
        "space",
        "connection",
        "directives"
      ],
      "Theta": [
        "source_reputation",
        "freshness",
        "consistency",
        "observation_confidence",
        "observed_action_reliability"
      ],
      "E": "deterministic_positive_marginal_potential_then_safety_filter",
      "information_structure": "partial",
      "stability_criterion": "positive feasible marginal utility; incumbent coordinator retained within 3 utility units; minimum 3 ticks unless unavailable"
    },
    "applicability": {
      "entry": [
        {
          "op": "gt",
          "left": {
            "path": "features.searchers"
          },
          "right": {
            "value": 0
          }
        }
      ],
      "continuation": [
        {
          "op": "gt",
          "left": {
            "path": "features.searchers"
          },
          "right": {
            "value": 0
          }
        }
      ],
      "exit": [
        {
          "op": "not",
          "arg": {
            "op": "gt",
            "left": {
              "path": "features.searchers"
            },
            "right": {
              "value": 0
            }
          }
        }
      ],
      "emergency_exit": [
        {
          "op": "eq",
          "left": {
            "path": "features.hard_stop"
          },
          "right": {
            "value": true
          }
        }
      ]
    },
    "roles": [
      "scout"
    ],
    "objectives": [
      "Распределённый поиск и покрытие"
    ],
    "constraints": [
      "public_limits_required",
      "one_command_per_agent",
      "reserve",
      "swept_collision",
      "restricted_zone",
      "operator_safety"
    ],
    "allowed_actions": [
      "move",
      "observe"
    ],
    "execution": {
      "handler": "search",
      "arbitration": "recovery > relay > service > search",
      "completion": "re-evaluate entry after each public observation",
      "messages": "coordination announcements; no remote command injection",
      "journal": "observation hash, candidates, utilities, roles, safety, result"
    },
    "transition_targets": [
      "priority_service",
      "relay_coalition",
      "safe_degradation",
      "coordination_reconfiguration"
    ],
    "metrics": [
      "mission_completion",
      "energy_used",
      "connectivity_score",
      "assignment_utility"
    ]
  },
